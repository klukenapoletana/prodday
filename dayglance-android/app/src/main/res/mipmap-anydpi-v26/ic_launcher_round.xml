<?xml version="1.0" encoding="utf-8"?>
<!-- No <monochrome> layer on purpose: a launcher with themed icons draws a
     monochrome layer on a coloured plate, and the icon is meant to stand as a
     bare white glyph, like an icon pack's. Without it the launcher shows the
     transparent foreground as it is. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
